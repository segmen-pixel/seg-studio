# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.venv-windows/
.env
.secret_key
.secrets.json
teacher_model/

# Node
node_modules/
dist/
# Ignore everything under build/ except launcher assets (start.py, icon)
# which build_installer.py copies into staging. Parent dirs must be
# re-included step by step for the leaf exception to take effect.
build/*
!build/installer/
build/installer/*
!build/installer/launcher/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Generated docs (Marp → PDF; source .md is tracked, PDF is not)
docs/**/*.pdf

# ── Project data (all user data, never track) ──
projects/
# ...but the UI source folder of the same name is code, not data
!apps/trainer_ui/src/components/projects/

# ── Runtime directories ──
state/
storage/
logs/

# Internal development tools (not for OSS distribution)
scripts/development_tools/

# Script outputs
scripts/oneshot/*.log

# Model checkpoints (large binary files)
models/
*.pt
*.pth
# …but keep the bundled combo-predictor artifacts (XGBoost boosters + PCA, ~1.2 MB)
!packages/segcore/segcore/auto_select/models/
!packages/segcore/segcore/auto_select/models/**

# SAM comparison output
scripts/sam_comparison_output/

# Temp/dev artifacts
*.bundle
tmp_*.png
test-results/
*.db

# Debug screenshots & one-off images
debug_screenshots/
apps/trainer_ui/debug_screenshots/
gui_*.png
debug_*.png
architecture_diagram.html

# Installer output
installer/output/

_benchmark_cache/
val_predictions_*/

# ── E2E test outputs (keep specs, exclude artifacts) ──
apps/trainer_ui/e2e/screenshots/
apps/trainer_ui/e2e-results/
apps/trainer_ui/e2e/_archive/
apps/trainer_ui/e2e/E2E_REDESIGN.md

apps/trainer_ui/e2e/E2E_TEST_PLAN.md
apps/trainer_ui/e2e/UX_COVERAGE_EXPANSION*.md

.venv-macos/

# ── SBOM artifacts (release-scoped, generated by CI; not version-controlled) ──
# Local sanity-check outputs from cyclonedx-py / syft.
# Per-release SBOMs are attached to GitHub Releases by .github/workflows/sbom.yml.
sbom*.json
sbom*.spdx*
*.cdx.json
*.spdx.json

# Local-only Playwright verify scripts (not part of the test suite)
apps/trainer_ui/verify_*.mjs

# The live model registry and exported graphs never ship.
models/registry/
*.onnx

# screenshot-cli output
apps/trainer_ui/e2e/_tools/screenshots/
