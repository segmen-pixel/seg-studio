# Seg-Studio environment variables.
# Every variable listed here is read by the code; see the referenced files.

# ── Server ──────────────────────────────────────────────────────
# Bind address for the API servers (default: 127.0.0.1, local-only).
# Read by the start scripts and Dockerfiles, passed to uvicorn --host.
SEG_HOST=127.0.0.1

# ── Optional API token (LAN/reverse-proxy deployments) ─────────
# Set to a random secret to require callers to send
#   X-API-Token: <value>
# on every request to /api/v1/*. Leave blank (default) to disable
# — safe only for localhost-only deployments. See SECURITY.md.
# (apps/trainer_api/app/core/config.py)
# SEG_API_TOKEN=

# ── Storage ────────────────────────────────────────────────────
# Root directory for all project data (images, masks, models, etc.)
# (apps/trainer_api/app/core/config.py; default: <repo>/projects)
# SEG_PROJECTS_DIR=./projects

# SQLite database path (apps/trainer_api/app/db.py;
# default: $SEG_PROJECTS_DIR/app.db)
# SEG_DB_PATH=./projects/app.db

# Directory for exported/registered models
# (apps/trainer_api/app/core/config.py, apps/serving_api/app/main.py;
# default: <repo>/models)
# SEG_MODELS_DIR=./models

# ── Training ───────────────────────────────────────────────────
# Torch device for training/inference: auto (default), cpu, cuda,
# or an explicit index like cuda:0 / cuda:1.
# (apps/trainer_api/app/core/config.py: SEG_TORCH_DEVICE)
# SEG_TORCH_DEVICE=auto

# ── Annotation reverse proxy (optional; OFF by default) ────────
# When unset, the /cvat/* and /annotate/* proxy routes are NOT mounted
# (closes the SSRF surface on LAN deployments — see
# apps/trainer_api/app/routers/root.py). Set only when the upstream
# annotation service is actually running.
# SEG_CVAT_URL=http://localhost:8080
# SEG_ANNOTATION_URL=http://localhost:8081
